
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin
testbin/*
Dockerfile.cross

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Kubernetes Generated files - skip generated files, except for vendored files

!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
*.swp
*.swo
*~

# Local credentials, environment files, and infrastructure state
# Keep sanitized example files available for documentation.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json
*.tfplan
tfplan
.terraform/
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
.aws/
.kube/
kubeconfig
kubeconfig.*
credentials.json
service-account*.json
.DS_Store

# Allow sanitized templates after all sensitive-file patterns.
!.env.example
!.env.sample
!.env.template
!*.example.tfvars
!*.example.tfvars.json
